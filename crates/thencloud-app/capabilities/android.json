{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android-native",
  "description": "What Android's WebView can't do by itself, through the thencloud plugin: saving a download, showing what music is playing (and keeping it playing in the background), and sharing files in from and out to other apps. Nothing else.",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "thencloud:allow-save-begin",
    "thencloud:allow-save-write",
    "thencloud:allow-save-end",
    "thencloud:allow-media-update",
    "thencloud:allow-media-artwork",
    "thencloud:allow-media-stop",
    "thencloud:allow-network-status",
    "thencloud:allow-share-pending",
    "thencloud:allow-share-read",
    "thencloud:allow-share-done",
    "thencloud:allow-share-out-begin",
    "thencloud:allow-share-out-write",
    "thencloud:allow-share-out-end"
  ]
}

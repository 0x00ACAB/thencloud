<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+), with a monochrome layer for themed icons
     (Android 13+), which the launcher tints with the wallpaper's colours. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/thencloud_launcher_background" />
    <foreground android:drawable="@drawable/thencloud_launcher_foreground" />
    <monochrome android:drawable="@drawable/thencloud_launcher_foreground" />
</adaptive-icon>
